# Every env var for every service, documented. Copy to .env and edit.
# The values below ARE the dev defaults; the stack boots with an empty
# .env. Change passwords for anything beyond local dev.

# data layer: postgres admin (services connect as migrator/ingestor/orchestrator)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=sports

MIGRATOR_DB_PASSWORD=dev_migrator
INGESTOR_DB_PASSWORD=dev_ingestor
ORCHESTRATOR_DB_PASSWORD=dev_orchestrator

# orchestrator (M4): ORC_LLM_PROVIDER=groq uses Groq's OpenAI-compatible
# endpoint; ORC_LLM_API_KEY stays in your real .env, never here.
# ORC_FEW_SHOT_K=0 disables retrieval; run `make ingest` once first.
# Few-shot retrieval reads the Chroma collection at data/chroma/.
ORC_LLM_PROVIDER=fake
ORC_LLM_TIMEOUT_SECONDS=30
ORC_LLM_BASE_URL=
ORC_LLM_API_KEY=
ORC_LLM_MODEL=llama-3.3-70b-versatile
ORC_LLM_TEMPERATURE=0
ORC_LLM_MAX_TOKENS=1024
ORC_FEW_SHOT_K=3
ORC_RETRIEVAL_CHROMA_DIR=
ORC_CORPUS_PATH=
ORC_MAX_REPAIR_ATTEMPTS=2
ORC_DATABASE_URL=postgresql://orchestrator:dev_orchestrator@localhost:5432/sports
ORC_DB_MAX_CONNECTIONS=5
ORC_DB_STATEMENT_TIMEOUT_MS=5000
ORC_MANIFEST_PATH=
ORC_CACHE_REDIS_URL=
ORC_CACHE_TTL_SECONDS=300
ORC_LOG_LEVEL=INFO

# ingestor: serve=daemon loop, once=incremental, seed=rebuild all (M2/I1-I5)
INGESTOR_DATABASE_URL=postgres://ingestor:dev_ingestor@localhost:5432/sports
INGESTOR_SOURCES_CONFIG=
INGESTOR_DAEMON_INTERVAL_SECONDS=300
INGESTOR_LOG_LEVEL=INFO

# gateway (M3): empty GATEWAY_API_KEY disables authn; empty
# GATEWAY_REDIS_URL disables cache + rate limit for host-side runs.
GATEWAY_LISTEN_ADDR=:8080
GATEWAY_ORCHESTRATOR_URL=http://localhost:8000
GATEWAY_ORCHESTRATOR_TIMEOUT=20
GATEWAY_REDIS_URL=
GATEWAY_API_KEY=
GATEWAY_RATE_LIMIT_PER_MINUTE=60
GATEWAY_LOG_LEVEL=INFO

# M5: `docker compose up` interpolates these values straight into the
# containers and overrides the localhost URLs/Redis with the service
# DNS names (postgres/redis/orchestrator), so one .env drives host runs
# and the containerized E2E stack; ORC_DATABASE_URL inside compose is
# always orchestrator:${ORCHESTRATOR_DB_PASSWORD}@postgres:5432/sports.
